	)
	(text "WS2812 decides \"1\" at 0.7 of own supply voltage.\nSupply voltage at 5V, *0.7 = 3.5V threshold.\nMCU sends a \"1\" at 3.3V -> below threshold,\nLED would never see a \"1\".\n\nThis chip \"converts\" data signal from MCU to a clear +5V for \"1\"\nso data signal is unambiguous towards SK6812."
		(exclude_from_sim no)
		(at 225.044 133.604 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b111839c-e186-4e1b-a824-290a0c8d24a5")
	)
